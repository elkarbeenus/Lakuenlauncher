{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LakuenLauncher",
  "version": "0.1.1",
  "identifier": "de.lakuen.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LakuenLauncher",
        "width": 1320,
        "height": 840,
        "minWidth": 920,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Game",
    "shortDescription": "Lokaler Spiele- und App-Launcher für SteamOS/Linux",
    "longDescription": "LakuenLauncher verwaltet AppImages und Windows-Spiele (.exe über Proton) an einem Ort – mit eigenem Artwork, Spielzeit-Statistik und ohne Konto oder Datensammlung.",
    "copyright": "Dominic Lesina x Claude",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
